# ── The Interns Bot platform ─────────────────────────────────────────────────
# Telegram token for @the_interns_bot (management / relay bot)
THE_INTERNS_BOT_TOKEN=

# Your bankr.bot wallet address — receives 10% platform fee from every service payment
PLATFORM_WALLET=

# Absolute path to this project (used in generated SKILL.md files)
# Default: /opt/interns
INTERNS_DIR=/opt/interns

# ── Voice enrichment ─────────────────────────────────────────────────────────
# bankr.bot API key — used to call Claude via bankr's LLM Gateway (https://llm.bankr.bot)
# Get yours at https://bankr.bot/api  →  enable "LLM Gateway"
# Top up credits at https://bankr.bot/llm?tab=credits
# Format: bk_YOUR_KEY
BANKR_API_KEY=

# LLM model to use via bankr gateway (default: gemini-3-flash)
# Options: gemini-3-flash, claude-haiku-3-5, claude-sonnet-4-5
LLM_MODEL=gemini-3-flash

# X/Twitter Bearer Token — used by scrape-x.ts
X_BEARER_TOKEN=

# YouTube Data API v3 key — used by scrape-youtube.ts to list channel videos
YOUTUBE_API_KEY=

# ── x402 Payment Server ──────────────────────────────────────────────────────
# Port the x402 HTTP server listens on (default: 4402)
X402_PORT=4402

# Public base URL of the x402 server (used in payment requirements + discovery)
# On the VPS: https://api.interns.bot  or  http://YOUR_SERVER_IP:4402
X402_BASE_URL=http://localhost:4402

# Network: "base-sepolia" for testnet, "base" for mainnet
X402_NETWORK=base-sepolia

# Coinbase Developer Platform client key — enables the OnchainKit paywall UI
# Get yours at https://portal.cdp.coinbase.com → create project → get Client Key
CDP_CLIENT_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────
# Set to "true" to print verbose debug output in scripts
DEBUG=false
